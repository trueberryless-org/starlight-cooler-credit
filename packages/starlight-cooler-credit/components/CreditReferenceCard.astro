---
import { Image } from "astro:assets";

import { getCredit } from "../libs/credit";
import { getCreditImage } from "../libs/image";

type Props = astroHTML.JSX.HTMLAttributes;

const { class: className, ...attrs } = Astro.props;

const credit = getCredit(Astro.locals.t, Astro.currentLocale);
const image = getCreditImage();
---

<aside
  class:list={["not-content", "starlight-cooler-credit-aside", className]}
  {...attrs}
>
  <a href={credit.href}>
    <h2>{credit.title}</h2>
    <div>
      <div>{credit.description && <p>{credit.description}</p>}</div>
      {image && (
        <div>
          <Image src={image.src} alt={image.alt} width={180} />
        </div>
      )}
    </div>
  </a>
</aside>

<style>
  .starlight-cooler-credit-aside {
    position: relative;
    background-color: var(--sl-color-gray-6);
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-text-accent);
    box-shadow: var(--sl-shadow-md);
    overflow-y: hidden;
  }
  .starlight-cooler-credit-aside a:link {
    text-decoration: none !important;
  }
  .starlight-cooler-credit-aside a::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .starlight-cooler-credit-aside > a > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .starlight-cooler-credit-aside h2 {
    color: var(--sl-color-white);
    font-size: var(--sl-text-h5);
    font-weight: 600;
    text-decoration: none !important;
    line-height: var(--sl-line-height-headings);
    margin-bottom: 0.5rem;
  }
  .starlight-cooler-credit-aside p {
    font-size: var(--sl-text-xs);
    line-height: normal;
    text-decoration: none !important;
    color: var(--sl-color-gray-3);
    overflow-wrap: anywhere;
  }
  .starlight-cooler-credit-aside > a > div > div:last-child {
    display: flex;
    align-items: end;
  }
  .starlight-cooler-credit-aside img {
    margin-bottom: -1rem;
    transition: transform 0.3s;
    transform: translateY(2px);
    width: 5.5rem;
    height: auto;
  }
  .starlight-cooler-credit-aside:hover img {
    transform: translateY(0px);
  }
</style>
